{
  "name": "raspberry-agent-transfert",
  "version": "0.1.0",
  "private": true,
  "description": "Agent local HTTP + Socket.IO + SCP pour envoyer des fichiers audio vers les Raspberry Pi",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "tsx watch src/app.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "ssh2": "^1.16.0",
    "uuid": "^11.0.5",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "@types/ssh2": "^1.15.4",
    "supertest": "^7.0.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
